# AeroCPI Environment Configuration
# ARCHITECTURE.md Section 2 (Tech stack) & User specifications

# Database (SQLite for local dev, Postgres for containerized production)
DATABASE_URL=sqlite:///./aerocpi.db
# DATABASE_URL=postgresql://aerocpi_user:aerocpi_secret_password@localhost:5432/aerocpi_db

# JWT Authentication
JWT_SECRET=change-this-in-production-aero-cpi-super-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Analyst Seed User (non-institutional domain)
SEED_ANALYST_EMAIL=demo.analyst@aerocpi.local
# Set your secure seed analyst password below (DO NOT commit actual secrets)
SEED_ANALYST_PASSWORD=ReplaceWithYourSecurePassword123!

# Storage landing zone for raw immutable scrape snapshots (S3/MinIO/Local)
RAW_STORAGE_DIR=./data/raw

# Optional: Gemini API Key for LLM fallback extraction (ARCHITECTURE.md Section 2)
# GEMINI_API_KEY=your_gemini_api_key_here
